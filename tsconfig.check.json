// Specialized tsconfig for type-checking js files
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "skipLibCheck": true
    },
    "include": [
        "**/*.js",
        "**/*.d.ts"
    ],
    "exclude": [
        "**/build",
        "node_modules/",
        "test/**",
        "main.test.js",
        "widgets/",
        "gulpfile.js"
    ]
}
